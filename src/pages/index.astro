---
import ThemeToggle from '../components/ThemeToggle.astro';
import { getJustifiedRows, series } from '../data/series';

const projects = series.map((project) => ({
	...project,
	image: project.cover.image,
	alt: project.cover.alt,
	width: project.cover.width,
	height: project.cover.height,
	aspectRatio: project.cover.aspectRatio,
	orientation: project.cover.orientation,
}));

const projectRows = getJustifiedRows(projects);
---

<html lang="en">
    <head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Richards Gonzalez's analogue photography, collected slowly." />
		<meta name="theme-color" content="#f2efe8" />
		<link rel="icon" href="/film-photography-portfolio/favicon.svg" />
		<script is:inline>
			let savedTheme;
			try {
				const storedTheme = localStorage.getItem('portfolio-theme');
				if (storedTheme === 'light' || storedTheme === 'dark') savedTheme = storedTheme;
				else if (storedTheme !== null) localStorage.removeItem('portfolio-theme');
			} catch {}
			const preferredTheme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			document.documentElement.dataset.theme = preferredTheme;
			document.documentElement.style.colorScheme = preferredTheme;
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', preferredTheme === 'dark' ? '#1d211d' : '#f2efe8');
		</script>
		<title>Richards Gonzalez — Film photography</title>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/film-photography-portfolio/" aria-label="Richards Gonzalez home">
				<span>RG</span>
				<span class="wordmark-caption">Film photography</span>
			</a>
			<div class="header-actions">
				<nav aria-label="Primary navigation">
					<a href="#work">Selected work</a>
					<a href="#about">About</a>
					<a href="#contact">Contact <span aria-hidden="true">↗</span></a>
				</nav>
				<ThemeToggle />
			</div>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow reveal">A collection of moments on film <span class="eyebrow-dot"></span> 35mm</p>
					<h1 id="hero-title" class="reveal reveal-delay-1">Light, left<br /><em>unhurried.</em></h1>
					<div class="hero-footer reveal reveal-delay-2">
						<p>Photography by Richards Gonzalez<br />Made between places, 2019—present.</p>
						<a class="text-link" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
					</div>
				</div>
				<div class="hero-image-wrap reveal reveal-delay-2">
					<img class="hero-image" src="/film-photography-portfolio/images/header.JPG" alt="A film photograph from the portfolio" fetchpriority="high" />
					<div class="image-note"><span>Fig. 00</span><span>Somewhere west</span></div>
				</div>
			</section>

			<section class="intro section-rule" id="about" aria-labelledby="intro-title">
				<p class="section-index">00 / Note</p>
				<div class="intro-body">
					<h2 id="intro-title">A practice of<br /><em>paying attention.</em></h2>
					<div class="intro-copy">
						<p>These photographs are small records of being there: a changing sky, a room before anyone arrives, the way a familiar road looks in a different season.</p>
						<p>Shot on analogue cameras and developed with patience. This is an evolving archive of the ordinary becoming briefly luminous.</p>
						<a class="text-link" href="#contact">More about the photographer <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>

			<section class="work section-rule" id="work" aria-labelledby="work-title">
				<div class="section-heading">
					<p class="section-index">01 / Selected work</p>
					<h2 id="work-title">Recent<br /><em>observations</em></h2>
					<p class="section-aside">Three ongoing series<br />from the archive</p>
				</div>
				<div class="project-grid">
					{projectRows.map((row) => (
						<div class="project-row" style={`--row-template: ${row.columns};`}>
							{row.items.map((project) => (
								<a class="project" href={`/film-photography-portfolio/work/${project.slug}/`}>
									<div class="project-frame">
										<img class="project-image" src={project.image} alt={project.alt} width={project.width} height={project.height} data-orientation={project.orientation} loading="lazy" />
										<span class="project-arrow" aria-hidden="true">↗</span>
									</div>
									<div class="project-caption">
										<span>{project.number}</span>
										<span>{project.title}</span>
										<span>{project.meta}</span>
									</div>
								</a>
							))}
						</div>
					))}
				</div>
			</section>

			<section class="contact section-rule" id="contact" aria-labelledby="contact-title">
				<p class="section-index">02 / Get in touch</p>
				<div class="contact-content">
					<h2 id="contact-title">Have a look<br /><em>around.</em></h2>
					<div>
						<p>Available for editorial commissions, quiet collaborations, and conversations about photographs.</p>
						<a class="contact-link" href="mailto:richards.gzan@gmail.com">richards.gzan@gmail.com <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<span>© {new Date().getFullYear()} Richards Gonzalez</span>
			<span>Made slowly / On film</span>
			<a href="#hero-title">Back to top ↑</a>
		</footer>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&display=swap');

	:global(*) { box-sizing: border-box; }
	:global(html) { scroll-behavior: smooth; }
	:global(body) { margin: 0; background: var(--paper); color: var(--ink); font-family: 'DM Mono', monospace; font-size: 13px; line-height: 1.55; transition: background-color .3s ease, color .3s ease; }
	:global(a) { color: inherit; text-decoration: none; }
	:global(::selection) { background: var(--highlight); color: var(--ink); }
	.site-header, .site-footer { display: flex; align-items: flex-start; justify-content: space-between; padding: 28px 4.4vw; }
	.site-header { position: absolute; z-index: 2; width: 100%; }
	.wordmark { display: flex; align-items: baseline; gap: 14px; font-weight: 500; letter-spacing: .04em; }
	.wordmark-caption, .section-index, .eyebrow, .image-note, .project-caption, .section-aside { color: var(--muted); font-size: 10px; letter-spacing: .09em; text-transform: uppercase; }
	.header-actions { display: flex; align-items: center; gap: 28px; }
	nav { display: flex; gap: 28px; }
	nav a, .text-link, .contact-link, .site-footer a { transition: color .2s ease; }
	nav a:hover, .text-link:hover, .contact-link:hover, .site-footer a:hover { color: var(--accent); }
	main { overflow: hidden; }
		.hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); min-height: 100vh; padding: 100px 4.4vw 50px; align-items: center; gap: 4vw; }
	.hero-copy { padding-top: 5vh; }
	.eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 58px; }
	.eyebrow-dot { width: 5px; height: 5px; background: var(--accent); border-radius: 50%; }
	h1, h2 { font-family: 'Newsreader', serif; font-weight: 300; letter-spacing: -.045em; line-height: .88; margin: 0; }
	h1 { font-size: clamp(4.8rem, 10vw, 10rem); }
	h1 em, h2 em { color: var(--accent); font-weight: 300; }
	.hero-footer { display: flex; align-items: flex-end; justify-content: space-between; max-width: 500px; margin-top: 9vh; color: var(--muted); font-size: 11px; }
	.hero-footer p { margin: 0; }
	.text-link { border-bottom: 1px solid var(--accent); color: var(--accent); padding-bottom: 5px; }
	.text-link span, .contact-link span { padding-left: 7px; }
	.hero-image-wrap { position: relative; width: min(100%, 650px); justify-self: end; }
	.hero-image-wrap::after { position: absolute; right: -16px; bottom: -16px; z-index: -1; width: 46%; height: 44%; border-right: 1px solid var(--accent); border-bottom: 1px solid var(--accent); content: ''; }
	.hero-image { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: saturate(.78) contrast(.96); }
	.image-note { display: flex; justify-content: space-between; margin-top: 10px; }
	.section-rule { border-top: 1px solid var(--line); margin: 0 4.4vw; padding: 110px 0 140px; }
	.intro { display: grid; grid-template-columns: 20% 1fr; }
	.intro-body, .contact-content { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; }
	h2 { font-size: clamp(3.6rem, 6.6vw, 7.4rem); }
	.intro-copy { max-width: 380px; padding-top: 10px; color: var(--muted); }
	.intro-copy p { margin: 0 0 22px; }
	.intro-copy .text-link { display: inline-block; margin-top: 15px; }
	.section-heading { display: grid; grid-template-columns: 20% 1fr 20%; align-items: end; margin-bottom: 70px; }
	.section-heading h2 { grid-column: 2; }
	.section-aside { grid-column: 3; margin: 0 0 8px; text-align: right; line-height: 1.7; }
	.project-grid { display: flex; flex-direction: column; gap: 7vw; }
	.project-row { display: grid; grid-template-columns: var(--row-template); gap: 2.4vw; align-items: start; }
	.project-frame { position: relative; overflow: hidden; background: var(--frame); }
	.project-image { display: block; width: 100%; height: auto; filter: saturate(.73) contrast(.95); transition: transform .6s cubic-bezier(.2,.7,.2,1), filter .6s ease; }
	.project:hover .project-image { transform: scale(1.035); filter: saturate(1) contrast(1); }
	.project-arrow { position: absolute; right: 16px; bottom: 14px; display: grid; width: 37px; height: 37px; place-items: center; border: 1px solid var(--control-border); border-radius: 50%; color: var(--paper); opacity: 0; transform: translate(-7px, 7px); transition: opacity .35s ease, transform .35s ease; }
	.project:hover .project-arrow { opacity: 1; transform: translate(0); }
	.project-caption { display: grid; grid-template-columns: 12% 1fr auto; gap: 12px; padding-top: 13px; }
	.project-caption span:nth-child(2) { color: var(--ink); }
	.contact { padding-bottom: 110px; }
	.contact-content { margin-top: 35px; }
	.contact-content > div { max-width: 340px; padding-top: 9px; color: var(--muted); }
	.contact-content p { margin: 0 0 27px; }
	.contact-link { display: inline-block; border-bottom: 1px solid var(--accent); color: var(--accent); padding-bottom: 7px; }
	.site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
	.reveal { animation: reveal .9s cubic-bezier(.2,.7,.2,1) both; }
	.reveal-delay-1 { animation-delay: .1s; }
	.reveal-delay-2 { animation-delay: .22s; }
	@keyframes reveal { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
	@media (max-width: 850px) and (min-width: 701px) {
		.hero { grid-template-columns: minmax(0, .95fr) minmax(0, 1fr); gap: 3vw; }
		h1 { font-size: clamp(3.4rem, 8vw, 4.8rem); }
		.hero-footer { align-items: flex-start; gap: 20px; flex-direction: column; }
	}
	@media (max-width: 700px) {
		.site-header, .site-footer { padding: 22px 6vw; }
		.header-actions { gap: 14px; }
		.wordmark-caption { display: none; }
		nav { gap: clamp(6px, 2vw, 10px); font-size: clamp(8px, 2.5vw, 10px); }
		.hero { display: flex; flex-direction: column; align-items: stretch; min-height: auto; padding: 112px 6vw 78px; gap: 55px; }
		.hero-copy { padding-top: 0; }
		.eyebrow { margin-bottom: 42px; font-size: 9px; }
		h1 { font-size: clamp(4.2rem, 20vw, 7rem); }
		.hero-footer { align-items: flex-start; gap: 25px; flex-direction: column; margin-top: 45px; }
		.hero-image-wrap { width: 92%; margin-left: auto; }
		.section-rule { margin: 0 6vw; padding: 75px 0 90px; }
		.intro, .intro-body, .contact-content { display: block; }
		.intro-body h2, .contact-content h2 { margin: 35px 0 42px; }
		.intro-copy { max-width: 100%; }
		.section-heading { display: block; margin-bottom: 48px; }
		.section-heading h2 { margin: 35px 0 26px; }
		.section-aside { text-align: left; }
		.project-grid { display: block; }
		.project-row { display: block; }
		.project { display: block; width: 88%; margin: 0 0 56px auto; }
		.project-caption { grid-template-columns: 13% 1fr; }
		.project-caption span:last-child { grid-column: 2; }
		.site-footer { flex-wrap: wrap; gap: 10px 20px; }
	}
	@media (prefers-reduced-motion: reduce) {
		:global(html) { scroll-behavior: auto; }
		:global(body), nav a, .text-link, .contact-link, .site-footer a { transition: none; }
		.reveal { animation: none; }
		.project-image, .project-arrow { transition: none; transform: none; }
		.project:hover .project-image, .project:hover .project-arrow { transform: none; }
	}
</style>
</html>
